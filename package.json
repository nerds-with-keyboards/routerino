{
  "name": "routerino",
  "version": "2.6.4",
  "description": "The React router that Google can read. Built-in SSG, meta tags, sitemaps, and canonical URLs — zero dependencies, no framework lock-in.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerds-with-keyboards/routerino.git"
  },
  "keywords": [
    "router",
    "react",
    "seo",
    "prerender",
    "ssg",
    "static-site",
    "static-site-generator",
    "vite",
    "vite-plugin",
    "meta-tags",
    "open-graph",
    "sitemap",
    "seo-friendly",
    "jamstack",
    "zero-dependency"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nerds-with-keyboards/routerino/issues"
  },
  "homepage": "https://github.com/nerds-with-keyboards/routerino#readme",
  "files": [
    "dist",
    "types",
    "routerino-forge.js",
    "docs"
  ],
  "type": "module",
  "types": "types/routerino.d.ts",
  "main": "./dist/routerino.umd.cjs",
  "exports": {
    ".": {
      "types": "./types/routerino.d.ts",
      "import": "./dist/routerino.js",
      "require": "./dist/routerino.umd.cjs"
    },
    "./forge": {
      "types": "./types/routerino-forge.d.ts",
      "import": "./routerino-forge.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:app": "vite build test-apps/vite-app",
    "test:app:no-trailing": "vite build test-apps/vite-app-no-trailing",
    "test:integration": "npm run build && npm run test:app && npm run test:app:no-trailing",
    "test:react-versions": "node test-react-versions.js",
    "test:node-versions": "node test-node-versions.js",
    "validate": "npm run format:check && npm run lint && npm run build && npm run test:run",
    "check": "npm run validate && npm run check:package",
    "check:package": "node scripts/check-package.js",
    "prepack": "npm run check",
    "prepublishOnly": "npm run test:integration",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix .",
    "fix:entities": "find demo-prerender demo-static -name '*.jsx' -exec sed -i '' 's/\"/{\\\"}/g; s/'\"'\"'/{\\\"'\"'\"'}/g' {} +",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "express": "^5.2.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "prop-types": "^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": ">=4.0.0 <9.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "12.0.2"
  }
}
